{
  "name": "ddl-helper",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node node_modules/next/dist/bin/next dev",
    "build": "node node_modules/next/dist/bin/next build",
    "start": "node node_modules/next/dist/bin/next start",
    "collect:profile": "node scripts/collect-profile.mjs",
    "collect:board": "node scripts/collect-board.mjs",
    "collect:web": "node scripts/collect-web.mjs",
    "collect:timetable": "node scripts/collect-timetable.mjs",
    "collect:meetings": "node scripts/collect-meetings.mjs",
    "collect:all": "node scripts/collect-profile.mjs && node scripts/collect-timetable.mjs",
    "meetings:list": "node scripts/collect-meetings.mjs --list",
    "meetings:all": "node scripts/collect-meetings.mjs --all-groups",
    "meetings:publish": "node scripts/collect-meetings.mjs --all-groups --publish",
    "ingest:notices": "node scripts/ingest-notices.mjs",
    "test:deadline": "node scripts/test-deadline.mjs"
  },
  "dependencies": {
    "@tencent-ai/workbuddy-cloud-sdk": "dev",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "20.17.10",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.16",
    "typescript": "5.7.2"
  }
}
